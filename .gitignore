# --- сборки и кэш инструментов ---
build/
.rojo/
.rojo.json
__pycache__/
*.pyc
.serena/
.cache/
node_modules/
*.log

# --- бинарники арта: в git только манифесты и скрипты ---
*.fbx
*.blend
*.blend1
*.psd
*.rbxlx
*.rbxm
ART_ASSETS/textures/*.png
ART_ASSETS/models/*
!ART_ASSETS/models/README.md

# --- референсные картинки (тяжёлые, ~7 МБ каждая) остаются локально ---
ART_ASSETS/refs/*.png
ART_ASSETS/refs/**/*.png

# --- локальные бэкапы ---
backups/*
!backups/README.md

# --- вендорные тулзы ---
tools/blender/
tools/luau/

# --- локальные окружения пайплайнов (генерация рефов, image-to-3D) ---
tools/i2m/.venv/
tools/i2m/.tmp/
tools/refgen/.runner.lock
tools/refgen/__pycache__/
tools/i2m/__pycache__/
*.tmp

# --- редакторы и ОС ---
Thumbs.db
desktop.ini
.DS_Store
.obsidian/workspace.json
.obsidian/cache

# --- временные отчёты скриптов ---
ART_ASSETS/roadmap/_*.js
ART_ASSETS/roadmap/html_check.png
